#include <stdio.h>
#include <string.h>

int main()
{
    char names[6][30] = {
        "Ravi", "Anu", "Kavi", "Ravi", "Bala", "Anu"
    };

    char temp[30];
    int n = 6;

    /* Sorting names alphabetically */
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (strcmp(names[i], names[j]) > 0)
            {
                strcpy(temp, names[i]);
                strcpy(names[i], names[j]);
                strcpy(names[j], temp);
            }
        }
    }

    printf("Sorted names:\n");

    for (int i = 0; i < n; i++)
        printf("%s\n", names[i]);

    /* Binary search */
    char key[] = "Ravi";
    int low = 0, high = n - 1, found = -1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;
        int result = strcmp(names[mid], key);

        if (result == 0)
        {
            found = mid;
            break;
        }
        else if (result < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found != -1)
        printf("Name found at index %d\n", found);
    else
        printf("Name not found\n");

    /* Detect duplicates */
    printf("Duplicate names:\n");

    for (int i = 0; i < n - 1; i++)
    {
        if (strcmp(names[i], names[i + 1]) == 0)
            printf("%s\n", names[i]);
    }

    return 0;
}
